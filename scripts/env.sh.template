#!/bin/bash
# Copy this file to scripts/env.sh and fill in the paths for your machine.

# Directory holding the downloaded TACO-Train and LiveCodeBench files (see README).
export DATA_ROOT=/path/to/data
# Directory where RL checkpoints are written.
export CKPT_ROOT=/path/to/checkpoints

# --- Derived paths (usually no need to change) ---
export PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export TACO_TRAIN_FILE="$DATA_ROOT/taco_for_code_generation.pkl"
export LCB_EVAL_FILE="$DATA_ROOT/livecodebench_2408_2502.pkl"
export LCB_DATA_DIR="$DATA_ROOT/livecodebench_2408_2502"
export LIVECODEBENCH_DATA_PATH="$LCB_DATA_DIR"
